# Base URL of the deployed attendance application (no trailing slash).
SERVER_URL=https://attendance.yourcompany.com

# From Admin -> Offices & Network -> (office) -> Register Network.
OFFICE_ID=
AGENT_ID=

# One-time bootstrap credential shown ONLY at registration time. Not needed
# after the first successful `python agent.py register` — the issued signing
# secret is then stored locally in agent_state.json.
REGISTRATION_TOKEN=

# Minutes between heartbeats.
HEARTBEAT_INTERVAL=10
